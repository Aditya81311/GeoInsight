# Copy this file to .env and fill in as needed. Nothing here is required
# for the API to run — sensible defaults are already in app/config.py.

# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# DATA_DIR=data

# Optional: enables AI-generated insight via OpenRouter (/api/v1/insight).
# Without this, a rule-based template insight is used instead.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
